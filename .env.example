# ─── Required ────────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# ─── Hosts & Origins ─────────────────────────────────────────────────────────
# Comma-separated. For production add your domain: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins that may POST to Django (must include scheme + port)
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# ─── Database ────────────────────────────────────────────────────────────────
# Absolute path inside the container. Persisted via the sqlite_data Docker volume.
DATABASE_PATH=/app/data/db.sqlite3

# ─── TLS / SSL ───────────────────────────────────────────────────────────────
# Keep False when running behind an HTTP-only reverse proxy locally.
# Set True only when nginx/Traefik terminates HTTPS and forwards X-Forwarded-Proto.
SECURE_SSL_REDIRECT=False

# Duration in seconds of the HSTS header sent to browsers.
# 0 disables HSTS. 31536000 = 1 year (recommended for production).
SECURE_HSTS_SECONDS=0

# ─── Cookies ─────────────────────────────────────────────────────────────────
# Set True only when serving over HTTPS.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ─── Logging ─────────────────────────────────────────────────────────────────
DJANGO_LOG_LEVEL=WARNING
